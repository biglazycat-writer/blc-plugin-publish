{
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "main": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\:]).+$"
    },
    "mainView": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "settingsView": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "windows/amd64",
          "windows/arm64",
          "darwin/amd64",
          "darwin/arm64",
          "linux/amd64",
          "linux/arm64"
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "activation": {
      "type": "array",
      "items": {
        "enum": [
          "startup",
          "workspace.opened",
          "document.committed"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plugin": {
            "type": "string"
          },
          "service": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
          },
          "version": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "plugin",
          "service",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "contexts": {
                "type": "array",
                "items": {
                  "enum": [
                    "workspace",
                    "editor.document",
                    "editor.selection",
                    "resource"
                  ]
                },
                "minItems": 0,
                "maxItems": 256
              },
              "aiCallable": {
                "type": "boolean"
              },
              "externalEffect": {
                "type": "boolean"
              },
              "inputSchema": {
                "$ref": "#/$defs/argumentSchema"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              },
              "title": {
                "type": "string"
              },
              "entry": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\:]).+$"
              },
              "route": {
                "type": "string",
                "pattern": "^/"
              },
              "defaultLocation": {
                "enum": [
                  "tab",
                  "panel",
                  "window"
                ]
              },
              "multiple": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "title",
              "entry",
              "defaultLocation"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "menus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "enum": [
                  "editor.selection",
                  "editor.document",
                  "resource",
                  "toolbar"
                ]
              },
              "command": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              }
            },
            "required": [
              "location",
              "command"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              },
              "version": {
                "type": "string"
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
                },
                "minItems": 1,
                "maxItems": 256
              }
            },
            "required": [
              "id",
              "version",
              "methods"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              },
              "contract": {
                "const": "export.text"
              },
              "version": {
                "const": 1
              },
              "service": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              }
            },
            "required": [
              "id",
              "contract",
              "version",
              "service"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "editors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              },
              "title": {
                "type": "string"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\.[a-z0-9][a-z0-9.-]*$"
                },
                "minItems": 1,
                "maxItems": 256
              },
              "view": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              }
            },
            "required": [
              "id",
              "title",
              "extensions",
              "view"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              },
              "command": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
              },
              "intervalSeconds": {
                "type": "integer",
                "minimum": 10,
                "maximum": 31536000
              },
              "catchUp": {
                "enum": [
                  "skip",
                  "once"
                ]
              }
            },
            "required": [
              "id",
              "command",
              "intervalSeconds",
              "catchUp"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "displayName",
    "platforms",
    "contributes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "大懒猫创作平台 package.json.biglazycat",
  "description": "SDK API 1；宿主还校验平台、引擎版本、路径存在性、引用、重复 ID 与依赖。",
  "$defs": {
    "argumentSchema": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/argumentSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/argumentSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  }
}
