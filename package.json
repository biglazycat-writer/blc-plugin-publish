{
  "biglazycat": {
    "apiVersion": 1,
    "contributes": {
      "commands": [
        {
          "id": "publish.open",
          "title": "发布当前文章",
          "aiCallable": true,
          "externalEffect": false
        },
        {
          "id": "debug.status",
          "title": "检查插件状态",
          "aiCallable": true,
          "externalEffect": false
        },
        {
          "id": "config.read",
          "title": "读取账号状态",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "config.save",
          "title": "保存账号配置",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "connection.test",
          "title": "测试连接",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "connection.ip",
          "title": "检测出口 IP",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "materials.list",
          "title": "读取封面素材",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "draft.create",
          "title": "创建公众号草稿",
          "aiCallable": false,
          "externalEffect": true
        },
        {
          "id": "transfer.put",
          "title": "传输发布内容",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "article.save",
          "title": "保存本地发布稿",
          "aiCallable": false,
          "externalEffect": false
        },
        {
          "id": "article.read",
          "title": "读取本地发布稿",
          "aiCallable": false,
          "externalEffect": false
        }
      ],
      "menus": [
        {
          "location": "editor.document",
          "command": "publish.open"
        },
        {
          "location": "toolbar",
          "command": "publish.open"
        }
      ],
      "views": [
        {
          "id": "publish",
          "title": "微信公众号发布",
          "entry": "dist/ui/index.html",
          "defaultLocation": "tab",
          "route": "/publish",
          "multiple": true
        },
        {
          "id": "settings",
          "title": "公众号账号设置",
          "entry": "dist/ui/index.html",
          "defaultLocation": "tab",
          "route": "/settings"
        }
      ]
    },
    "description": "文章排版、图片与封面处理、素材库和官方 API 草稿发布。",
    "displayName": "微信公众号发布",
    "main": "dist/main.js",
    "mainView": "publish",
    "platforms": [
      "windows/amd64",
      "windows/arm64",
      "darwin/amd64",
      "darwin/arm64",
      "linux/amd64",
      "linux/arm64"
    ],
    "settingsView": "settings"
  },
  "dependencies": {
    "@biglazycat/plugin-sdk": "file:vendor/plugin-sdk",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "16.5.4",
    "i18next": "25.8.13",
    "lucide-react": "0.511.0",
    "juice": "11.1.1",
    "lowlight": "3.3.0",
    "highlight.js": "11.11.1",
    "katex": "0.16.47",
    "mermaid": "11.12.2",
    "sharp": "0.34.5",
    "undici": "7.22.0",
    "@tiptap/core": "3.32.1",
    "@tiptap/react": "3.32.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/katex": "0.16.8",
    "vite": "7.3.6",
    "vitest": "4.0.18",
    "jsdom": "28.1.0"
  },
  "engines": {
    "node": "22.23.3"
  },
  "name": "blc-plugin-publish",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -p tsconfig.node.json && vite build",
    "test": "node --test tests/*.test.mjs && vitest run"
  },
  "type": "module",
  "version": "0.1.0",
  "description": "大懒猫创作平台微信公众号发布插件",
  "files": [
    "dist",
    "vendor",
    "README.md"
  ]
}